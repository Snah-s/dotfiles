/*****----- Tema compartido de la familia "ajustes" -----*****

  Lo heredan los scripts que NO pasan -theme:
      scripts/settings.sh   scripts/wifi.sh   scripts/battery.sh

  NO afecta a launchers/type-1 ni a launchers/clipboard: ambos pasan su propio
  -theme, y un -theme explícito gana sobre este fichero. Si tocas esto y "no
  cambia nada", es que ese lanzador trae el suyo.

*******************************************************************/

@import "~/.config/rofi/colors/onedark.rasi"

* {
    font:             "JetBrains Mono Nerd Font Propo 10";
    text-color:       @foreground;
    background-color: transparent;
}

window {
    transparency:     "real";
    location:         center;
    width:            420px;
    border-radius:    10px;
    background-color: @background;
    padding:          12px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  10px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          8px;
    padding:          8px 10px;
    border-radius:    6px;
    background-color: @background-alt;
}

prompt { text-color: @selected; }
entry  { placeholder: "Buscar…"; placeholder-color: @background-alt; }

/* -mesg: se usa para mostrar el valor actual de cada ajuste */
message  { padding: 0px; }
textbox  {
    padding:          8px 10px;
    border-radius:    6px;
    background-color: @background-alt;
    text-color:       @active;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
}

element {
    spacing:       10px;
    padding:       8px 10px;
    border-radius: 6px;
}

/* Hay que declarar el fondo de CADA estado. Si se deja alguno sin poner, rofi
   lo saca de su tema interno, cuyo `alternate-normal-background` pinta las filas
   pares distintas: eso es el efecto cebra. Los selectores de estado ganan al
   `element` de arriba, así que un background-color ahí no basta. */
element normal.normal    { background-color: transparent; text-color: @foreground; }
element alternate.normal { background-color: transparent; text-color: @foreground; }
element normal.urgent    { background-color: transparent; text-color: @urgent;     }
element alternate.urgent { background-color: transparent; text-color: @urgent;     }
element normal.active    { background-color: transparent; text-color: @active;     }
element alternate.active { background-color: transparent; text-color: @active;     }

element selected.normal  { background-color: @selected; text-color: @background; }
element selected.urgent  { background-color: @urgent;   text-color: @background; }
element selected.active  { background-color: @active;   text-color: @background; }

/* size lo sube el picker de fondos con -theme-str; aquí solo aplica a las
   listas que van con -show-icons */
element-icon { size: 32px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; }

/* rofi -e (patrón de battery.sh) */
error-message { padding: 12px; border-radius: 10px; background-color: @background; }
